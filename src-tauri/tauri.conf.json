{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIshukatsu",
  "version": "0.2.21",
  "identifier": "com.aisyuukatsu.app",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:5173/desktop.html",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "AI就活",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://github.com https://api.github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com; frame-src 'self' blob: https://*.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'none'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "AI就活 — 就職活動管理デスクトップアプリ",
    "longDescription": "AI就活 は、就職活動の情報整理・記録・管理を支援するローカルファーストのデスクトップアプリケーションです。",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0QkM4MjlGODQ4MTVCODYKUldTR1c0R0VuNEs4Vk9GMWt6R1kramMyckFNd2N3TFFHVHFpS2ppVWtOUkpIRXNYTFUwSHJKV1UK",
      "endpoints": [
        "https://github.com/yamauchiyuhei/AIshukatsu/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "aisyuukatsu"
        ]
      }
    }
  }
}
